# Sam Bau — Vercel environment variables (names only, never commit real values).
#
# Contact form delivery via Resend (https://resend.com).
# All three variables are required in production; without them
# POST /api/contact returns a generic "currently unavailable" error.
#
# Destination mailbox for incoming leads (business owner inbox).
CONTACT_EMAIL_TO=
# Verified sender identity, e.g. "Sam Bau <noreply@sam-bau-kahl.de>".
# The domain must be verified in Resend.
EMAIL_FROM=
# Resend REST API key (server-side only, never expose to the browser).
RESEND_API_KEY=

# Optional follow-up: WhatsApp Business API integration for lead
# notifications. Not implemented — see audit report. Leave unset.
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
